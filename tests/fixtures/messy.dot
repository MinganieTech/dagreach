#!/usr/bin/env dot
/* Every syntactic corner dagreach promises to survive, in one file:
   the three comment styles, quoted identifiers, escaped quotes, string
   concatenation, HTML labels, ports, numeric identifiers, attribute
   defaults, edge chains, and an edge whose endpoint is a subgraph. */
strict digraph "pipeline" {
	rankdir = LR;          // a bare key = value statement
	node [shape = box, group = "core"]
	edge [duration = "2.5"]

	build:out -> test:in;                       // ports address a drawing, not a node
	test -> "deploy \"prod\"" -> monitor;       // an edge chain
	42 -> build                                 // a numeric identifier

	"long" + "_name" [label = <<b>concatenated</b>>, status = "ready"]
	"long_name" -> monitor [duration = "0.5", weight = "ignored-because-duration-wins"]

	subgraph cluster_smoke {
		smoke_a [status = "ready"]
		smoke_b [status = "blocked"]
	}
	monitor -> subgraph cluster_smoke { smoke_a; smoke_b }

	build -> test   /* declared twice: strict collapses it */
	monitor -> monitor
}
