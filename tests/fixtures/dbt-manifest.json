{
  "metadata": {
    "dbt_schema_version": "https://schemas.getdbt.com/dbt/manifest/v12.json",
    "dbt_version": "1.9.2",
    "project_name": "acme_analytics",
    "adapter_type": "snowflake"
  },
  "nodes": {
    "model.acme_analytics.stg_orders": {
      "resource_type": "model",
      "name": "stg_orders",
      "package_name": "acme_analytics",
      "schema": "staging",
      "path": "staging/stg_orders.sql",
      "config": { "materialized": "view", "tags": ["staging"] },
      "depends_on": { "nodes": ["source.acme_analytics.shop.orders"] }
    },
    "model.acme_analytics.fct_orders": {
      "resource_type": "model",
      "name": "fct_orders",
      "package_name": "acme_analytics",
      "schema": "marts",
      "path": "marts/fct_orders.sql",
      "config": { "materialized": "table", "tags": ["marts", "production"] },
      "depends_on": { "nodes": ["model.acme_analytics.stg_orders"] }
    },
    "test.acme_analytics.not_null_fct_orders_id": {
      "resource_type": "test",
      "name": "not_null_fct_orders_id",
      "package_name": "acme_analytics",
      "config": { "materialized": "test", "tags": [] },
      "depends_on": { "nodes": ["model.acme_analytics.fct_orders"] }
    }
  },
  "sources": {
    "source.acme_analytics.shop.orders": {
      "resource_type": "source",
      "name": "orders",
      "package_name": "acme_analytics",
      "schema": "raw",
      "database": "shop"
    }
  },
  "exposures": {
    "exposure.acme_analytics.revenue_dashboard": {
      "resource_type": "exposure",
      "name": "revenue_dashboard",
      "package_name": "acme_analytics",
      "depends_on": { "nodes": ["model.acme_analytics.fct_orders"] }
    }
  },
  "child_map": {
    "source.acme_analytics.shop.orders": ["model.acme_analytics.stg_orders"],
    "model.acme_analytics.stg_orders": ["model.acme_analytics.fct_orders"],
    "model.acme_analytics.fct_orders": [
      "test.acme_analytics.not_null_fct_orders_id",
      "exposure.acme_analytics.revenue_dashboard"
    ],
    "test.acme_analytics.not_null_fct_orders_id": [],
    "exposure.acme_analytics.revenue_dashboard": []
  }
}
