// `terraform graph` output for a small stack, shaped as Terraform writes it:
// an edge runs from a resource to what it depends on, and identifiers carry the
// renderer's decoration. The terraform profile handles both.
digraph {
	compound = "true"
	newrank  = "true"
	subgraph "root" {
		"[root] aws_vpc.main (expand)"                [label = "aws_vpc.main", shape = "box"]
		"[root] aws_subnet.public (expand)"           [label = "aws_subnet.public", shape = "box"]
		"[root] aws_subnet.private (expand)"          [label = "aws_subnet.private", shape = "box"]
		"[root] aws_security_group.web (expand)"      [label = "aws_security_group.web", shape = "box"]
		"[root] aws_security_group.database (expand)" [label = "aws_security_group.database", shape = "box"]
		"[root] aws_instance.web (expand)"            [label = "aws_instance.web", shape = "box"]
		"[root] aws_db_instance.orders (expand)"      [label = "aws_db_instance.orders", shape = "box"]
		"[root] aws_iam_role.app (expand)"            [label = "aws_iam_role.app", shape = "box"]
		"[root] provider[\"registry.terraform.io/hashicorp/aws\"]" [shape = "diamond"]

		"[root] aws_subnet.public (expand)"           -> "[root] aws_vpc.main (expand)"
		"[root] aws_subnet.private (expand)"          -> "[root] aws_vpc.main (expand)"
		"[root] aws_security_group.web (expand)"      -> "[root] aws_vpc.main (expand)"
		"[root] aws_security_group.database (expand)" -> "[root] aws_vpc.main (expand)"
		"[root] aws_instance.web (expand)"            -> "[root] aws_subnet.public (expand)"
		"[root] aws_instance.web (expand)"            -> "[root] aws_security_group.web (expand)"
		"[root] aws_instance.web (expand)"            -> "[root] aws_iam_role.app (expand)"
		"[root] aws_db_instance.orders (expand)"      -> "[root] aws_subnet.private (expand)"
		"[root] aws_db_instance.orders (expand)"      -> "[root] aws_security_group.database (expand)"
		"[root] aws_vpc.main (expand)"                -> "[root] provider[\"registry.terraform.io/hashicorp/aws\"]"
	}
}
